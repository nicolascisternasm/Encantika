# URL del proyecto Supabase
# Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública (anon) — segura de exponer en el frontend
# Dashboard → Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SECRETA, nunca la expongas en el frontend ni la subas al repo
# Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=
