# URL del proyecto Supabase
# Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Clave pública (anon) — segura de exponer en el frontend
# Dashboard → Settings → API → Project API keys → anon / public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service_role — SECRETA, nunca la expongas en el frontend ni la subas al repo
# Dashboard → Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key — necesaria para generar significados con IA en Arma tu Joya
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Google Drive Picker — para seleccionar imágenes desde Google Drive en el admin
# console.cloud.google.com → APIs → Google Drive API → Credenciales
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
